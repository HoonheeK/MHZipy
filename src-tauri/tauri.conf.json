{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mhzipy",
  "version": "1.0.5",
  "identifier": "com.marho-soft.mhzipy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mhzipy",
        "width": 1280,
        "height": 960,
        "dragDropEnabled": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mhzipy-update.marh-sw.com/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NUI0MTNEMzU0MTZGNkYKUldSdmIwRTFQVUZiMTRPWWQ3YjFQREZXVmk0QlV2WlFySDBpVHlmcjZqeXdiWWZBVk9RUmdUT0EK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": ["md", "markdown", "mdown", "mkdn", "mdx", "txt", "text", "log"],
        "name": "Markdown & Text Document",
        "description": "Markdown and Text Documents",
        "role": "Editor"
      },
      {
        "ext": ["jpg", "jpeg", "png", "webp", "bmp", "ico", "tiff", "tif", "gif", "svg", "avif", "jfif"],
        "name": "Image File",
        "description": "Image Files",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "mkv", "webm", "mov", "avi", "wmv", "flv", "m4v", "3gp", "ts", "asf", "rmvb", "mp3", "wav", "m4a", "flac", "ogg", "aac", "wma"],
        "name": "Media File",
        "description": "Audio and Video Files",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Korean",
          "Japanese",
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
